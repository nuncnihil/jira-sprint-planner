# Jira Configuration
# Copy this file to jira.env and fill in your values

# REQUIRED: Jira instance details (needed for all functionality)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token-here
JIRA_PROJECT_KEY=PROJ

# If you only have one team, you can leave this blank
JIRA_TEAM_ID=your-team-id-here

# OPTIONAL: Engineering Excellence auto-categorization
# When set, issues with 🔧 EE category will auto-assign to this Initiative/Epic
JIRA_EE_INITIATIVE="Engineering Excellence"
JIRA_EE_EPIC="Engineering Excellence"
JIRA_EE_LABEL="engineering-excellence"


# How to get your values:
# - API Token: https://id.atlassian.com/manage-profile/security/api-tokens
# - Team ID: Go to https://your-domain.atlassian.net/teams → click your team → URL shows /teams/{TEAM_ID}/overview
#           Or run: node scripts/inventory.js (after setup)
# - Project ID/Key: In Jira → Project Settings → Details → Project ID
# - Board Name: Selected in the app UI (not needed in config)

